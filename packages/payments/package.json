{
  "name": "@app-foundation/payments",
  "version": "0.1.1",
  "description": "Independent server-side WeChat Pay and Alipay clients",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./core": { "types": "./dist/core.d.ts", "default": "./dist/core.js" },
    "./wechat": { "types": "./dist/wechat.d.ts", "default": "./dist/wechat.js" },
    "./alipay": { "types": "./dist/alipay.d.ts", "default": "./dist/alipay.js" }
  },
  "files": ["dist", "src", "LICENSE", "NOTICE.md", "README.md", "tsconfig.json"],
  "engines": { "node": ">=22" },
  "repository": { "type": "git", "url": "https://github.com/2017YANR02/app-foundation.git", "directory": "packages/payments" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm build && node --test test/*.test.mjs",
    "prepack": "pnpm build"
  },
  "devDependencies": { "@types/node": "22.15.30", "typescript": "5.7.3" }
}
