{
  "name": "@app-foundation/workspace-ui",
  "version": "0.1.0",
  "description": "Host-adapted React workspace panels and layout",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./workspace.css": "./workspace.css",
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "tsconfig.json",
    "workspace.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/2017YANR02/app-foundation.git",
    "directory": "packages/workspace-ui"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm build",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.7.3",
    "@types/react": "19.2.2",
    "react": "19.2.0",
    "@app-foundation/workspace-policy": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19",
    "@app-foundation/workspace-policy": "0.1.0"
  }
