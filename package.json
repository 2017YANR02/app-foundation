{
  "name": "app-foundation-workspace",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "pack:payments": "pnpm --filter @app-foundation/payments pack --pack-destination artifacts",
    "pack:messaging": "pnpm --filter @app-foundation/messaging pack --pack-destination artifacts",
    "pack:verification": "pnpm --filter @app-foundation/verification pack --pack-destination artifacts",
    "pack:sms": "pnpm --filter @app-foundation/sms pack --pack-destination artifacts",
    "pack:account-policy": "pnpm --filter @app-foundation/account-policy pack --pack-destination artifacts",
    "pack:all": "pnpm pack:payments && pnpm pack:messaging && pnpm pack:verification && pnpm pack:sms && pnpm pack:account-policy && pnpm pack:face-verification && pnpm pack:workspace-policy && pnpm pack:workspace-ui && pnpm pack:registration-ui && pnpm pack:icons",
    "pack:face-verification": "pnpm --filter @app-foundation/face-verification pack --pack-destination artifacts",
    "pack:workspace-policy": "pnpm --filter @app-foundation/workspace-policy pack --pack-destination artifacts",
    "pack:workspace-ui": "pnpm --filter @app-foundation/workspace-ui pack --pack-destination artifacts",
    "pack:registration-ui": "pnpm --filter @app-foundation/registration-ui pack --pack-destination artifacts",
    "pack:icons": "pnpm --filter @app-foundation/icons pack --pack-destination artifacts"
  }
}
